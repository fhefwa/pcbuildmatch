# ============================================================
# PCBuildMatch - Backend
# Copiar a .env y completar los valores reales.
# .env está ignorado por Git. No commitear credenciales.
# ============================================================

# --- Aplicación ---
APP_NAME=PCBuildMatch
APP_ENV=development
DEBUG=true
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL ---
# Formato:
# postgresql+psycopg://pcbuildmatch:<contrasena>@localhost:5432/pcbuildmatch
# Si la contraseña contiene caracteres especiales (@, :, /, #), codificarlos
# para URL antes de armar la cadena.
DATABASE_URL=

# --- Proveedor de IA ---
# Valores permitidos: gemini | openai | anthropic | deepseek
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=60

# Completar únicamente la clave del proveedor seleccionado.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Modelos ---
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
DEEPSEEK_MODEL=deepseek-v4-pro
# OPENAI_MODEL=
# ANTHROPIC_MODEL=

# --- Endpoints de proveedores (opcionales) ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
