# ============================================================
# PCBuildMatch - .gitignore global del monorepo
# ============================================================

# ---------- Entornos virtuales Python ----------
venv/
.venv/
ENV/
env.bak/
venv.bak/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg
MANIFEST

# ---------- Testing y calidad Python ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# ---------- Node.js / Next.js ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.vercel
*.tsbuildinfo
next-env.d.ts

# ---------- Variables de entorno y secretos ----------
.env
.env.*
!.env.example
!**/.env.example
*.pem

# ---------- Logs ----------
logs/
*.log

# ---------- Bases de datos y dumps ----------
*.sqlite3
*.db
*.dump
pgdata/

# ---------- IDEs / editores ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Temporales ----------
.cache/
tmp/
temp/
